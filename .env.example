# Copy this file to .env for local development, or set these as
# environment variables / EC2 user-data on AWS.

# Flask
SECRET_KEY=change-this-to-a-random-string

# Database — leave unset for local SQLite, or point to your RDS instance:
# DATABASE_URL=mysql+pymysql://admin:YOUR_PASSWORD@your-db.xxxx.rds.amazonaws.com:3306/realestate
DATABASE_URL=

# Image storage — set USE_S3=true and fill in bucket details once deployed
USE_S3=false
S3_BUCKET=
AWS_REGION=ap-south-1

# App log file (tailed by CloudWatch agent on EC2)
LOG_FILE=app.log
